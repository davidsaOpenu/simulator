# Kernel configuration fragment for the exofs guest test.
# Merged on top of versions/kernel/7.0.2/.config by exofs/build.sh.
# exofs talks to the NVMe key/value commands exported by the NVMe core.
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_EXOFS_FS=m
# The initrd is built with the 26.04 udev, which renames eth0 to enp0s5; the
# 14.04 guest only configures eth0 (no network -> no ssh). The bootloader line
# comes from the shared builder.sh, so keep the classic names via a built-in
# command line that is appended to it.
CONFIG_CMDLINE_BOOL=y
CONFIG_CMDLINE="net.ifnames=0 biosdevname=0"
# CONFIG_CMDLINE_OVERRIDE is not set
