# host_tests_bounds.env  (generated by derive_bounds.py from HOST_TESTS_CASES_METRICS.md)
# Tolerant: bound = [min*(1-m), max*(1+m)], m = clamp(2*spread, 0.15, 0.50), spread = (max-min)/max.
# Scheduling-dependent (gc_invocations): m = 0.75 regardless of spread -- the count varies by host
#   scheduling (CI observed 4765-5592 vs local 7923-9803 for the sector case); the wide band
#   still catches GC-dead and GC-runaway while GC effects are gated by write_count,
#   write_amplification and disk_utilization.
# Tight (logical_write_count): bound = observed value exactly (deterministic pipeline sentinel).
# No bounds for the RUN_HEAVY=1 suites (ssd_write_read_tests, onfi_ops_tests) by design: they
#   run report-only -- no 5-run characterization exists at their 6-20M event volume. To gate
#   them, characterize and add BOUND_SSD_WRITE_READ_TESTS_* / BOUND_ONFI_OPS_TESTS_* entries.

# --- sector_tests  (n=5 runs) ---
#   logical_write_count    observed 30720 (deterministic; exact gate)
BOUND_SECTOR_TESTS_LOGICAL_WRITE_COUNT_MIN=30720
BOUND_SECTOR_TESTS_LOGICAL_WRITE_COUNT_MAX=30720
#   write_count            observed [32660, 32921] spread=0.79%
BOUND_SECTOR_TESTS_WRITE_COUNT_MIN=27761
BOUND_SECTOR_TESTS_WRITE_COUNT_MAX=37860
#   write_amplification    observed [1.0632, 1.0716] spread=0.78%
BOUND_SECTOR_TESTS_WRITE_AMPLIFICATION_MIN=0.9037
BOUND_SECTOR_TESTS_WRITE_AMPLIFICATION_MAX=1.2323
#   gc_invocations         observed [7923, 9803] spread=19.18%  <-- SPREAD>5%
BOUND_SECTOR_TESTS_GC_INVOCATIONS_MIN=1980
BOUND_SECTOR_TESTS_GC_INVOCATIONS_MAX=17156
#   disk_utilization_avg   observed [0.675832, 0.70496] spread=4.13%
BOUND_SECTOR_TESTS_DISK_UTILIZATION_AVG_MIN=0.5745
BOUND_SECTOR_TESTS_DISK_UTILIZATION_AVG_MAX=0.8107

