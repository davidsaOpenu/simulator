[global]
ioengine=sync
size=64m
filename=fs_benchmark.dat
end_fsync=1
# Run the jobs one after the other, never side by side
stonewall

[seq-write-4k]
rw=write
bs=4k

[rand-read-4k]
rw=randread
bs=4k

[seq-write-16k]
rw=write
bs=16k

[rand-read-16k]
rw=randread
bs=16k

[seq-write-64k]
rw=write
bs=64k

[rand-read-64k]
rw=randread
bs=64k

[seq-write-256k]
rw=write
bs=256k

[rand-read-256k]
rw=randread
bs=256k

[seq-write-1m]
rw=write
bs=1m

[rand-read-1m]
rw=randread
bs=1m
