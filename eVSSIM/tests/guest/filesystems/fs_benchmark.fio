[global]
ioengine=sync
size=64m
invalidate=0
random_distribution=zipf:1.2
filename=fs_benchmark.0:fs_benchmark.1:fs_benchmark.2:fs_benchmark.3:fs_benchmark.4:fs_benchmark.5:fs_benchmark.6:fs_benchmark.7:fs_benchmark.8:fs_benchmark.9:fs_benchmark.10:fs_benchmark.11:fs_benchmark.12:fs_benchmark.13:fs_benchmark.14:fs_benchmark.15
end_fsync=1
# Run the jobs one after the other, never side by side
stonewall

[seq-write-4k]
rw=write
bs=4k

[rand-read-4k]
rw=randread
bs=4k

[seq-write-16k]
rw=write
bs=16k

[rand-read-16k]
rw=randread
bs=16k

[seq-write-64k]
rw=write
bs=64k

[rand-read-64k]
rw=randread
bs=64k

[seq-write-256k]
rw=write
bs=256k

[rand-read-256k]
rw=randread
bs=256k

[seq-write-1m]
rw=write
bs=1m

[rand-read-1m]
rw=randread
bs=1m
