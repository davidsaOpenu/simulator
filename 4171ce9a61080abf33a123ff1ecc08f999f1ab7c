      "writtenOn": "2026-10-30T06:49:25Z",
      "side": 1,
      "message": "Issue: dist/tools keeps adding files and is never cleaned, except by run-ci. After a config switch, the old nvme,\n  libosd.so and kernel modules get copied into the new guest.\n  Suggestion: Clear dist/tools at the start of each build, or keep one tools directory per config.",
      "range": {
        "startLine": 453,
        "startChar": 1,
        "endLine": 455,
        "endChar": 33
      },
      "revId": "4171ce9a61080abf33a123ff1ecc08f999f1ab7c",
